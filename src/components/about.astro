---
import ContentSection from "./content-section.astro";
import type { FeatureItem } from "../types";

const features: Array<FeatureItem> = [
  {
    title: "AWS IA Certified",
    description:
      "AWS AI certified, with strong hands-on proficiency across AWS cloud architecture and services.",
  },
  {
    title: "JavaScript Specialist",
    description:
      "Eight years of experience building modern web and mobile applications with JavaScript, React, and related frameworks.",
  },
  {
    title: "UI/UX, A11Y Consulting & Cloud",
    description:
      "I provide professional accessibility consulting, design inclusive experiences in Figma, and turn them into polished products backed by modern cloud technology.",
  },
];
---

<ContentSection title="About me" id="aboutme">
  <Fragment slot="lead">
    Greetings, Im a <span class="text-primary">Web developer</span> and also a
    <span class="text-primary">UI/UX Designer</span>. <br /><br />
    With 8+ years of experience developing in multiple <span
      class="text-primary">JavaScript</span
    > frameworks and tech stacks with a strong focus on <span
      class="text-primary">A11y</span
    >.<br /><br />
    I can help you to build an awesome <span class="text-primary">web app</span
    >!
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    {
      features.map(({ title, description }) => (
        <li class="flex flex-col items-center gap-4 border border-default bg-offset p-6">
          <p class="text-center font-extrabold text-xl">{title}</p>
          <p class="text-center text-offset text-sm">{description}</p>
        </li>
      ))
    }
  </ul>
</ContentSection>
